# ─────────────────────────────────────────────────────────────
#  Nexia Swarm: copia este archivo a .env y completa los valores
#  (.env está en .gitignore: nunca subas tus claves al repo)
# ─────────────────────────────────────────────────────────────

# --- API de Claude (obligatoria salvo en --dry-run) ---
# Obtén tu clave en https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# --- Presupuesto y límites (control de costos) ---
# Presupuesto PREAPROBADO de tokens LLM por producto (USD). Al superarlo se pausa en el gate HITL #2.
BUDGET_USD_PER_TASK=5
# Máximo de ciclos Builder⇄QA (y Growth⇄QA). Al agotarlos, la tarea queda en failed y se escala a ti.
MAX_ITERATIONS=3
# Máximo de conceptos que puede proponer el Scout si los rechazas.
MAX_RESEARCH_ATTEMPTS=3

# --- Modelos (opcional) ---
# Modelo por defecto de todos los agentes. Precios en src/core/pricing.ts
SWARM_MODEL=claude-opus-5-5
# Sobrescribir por agente (ejemplo: un modelo más barato para Ops):
# MODEL_SCOUT=claude-opus-5-5
# MODEL_BUILDER=claude-opus-5-5
# MODEL_QA=claude-opus-5-5
# MODEL_GROWTH=claude-opus-5-5
# MODEL_OPS=claude-haiku-5-5
# Effort por agente: low | medium | high | xhigh | max (más alto = mejor calidad y más tokens)
# EFFORT_SCOUT=high
# EFFORT_BUILDER=medium
# EFFORT_QA=high
# EFFORT_GROWTH=medium
# EFFORT_OPS=low
# Si el modelo rechaza una solicitud por seguridad, la API reintenta con otro modelo ("default") u "off".
LLM_FALLBACKS=default

# --- Market Scout (exploración de oportunidades) ---
# Cuántas oportunidades distintas explora antes de elegir una.
SCOUT_CANDIDATES=10
# Dónde puede buscar. Por defecto, abierto a cualquier país, idioma, sector o segmento.
# Ejemplo para acotar: SCOUT_MARKETS=España, México y EE.UU. hispano
SCOUT_MARKETS=abierto: cualquier país, idioma, sector o segmento donde la oportunidad sea mejor
# Idiomas en los que el enjambre puede producir el kit (es, en, pt).
SCOUT_LANGUAGES=es,en,pt
# Temas que quieres evitar (opcional, separados por coma).
SCOUT_EXCLUDE=
# Búsqueda web real (API de pago: ~US$10 por 1000 búsquedas). Muy recomendable para explorar
# mercados desconocidos. Siempre pide aprobación (gate #2) antes de usarla.
SCOUT_WEB_SEARCH=false
SCOUT_WEB_SEARCH_MAX_USES=8

# --- Producto ---
KIT_MAX_FILES=8

# --- Lanzamiento ---
# Marca que firma la landing. Vacío = se usa el nombre del producto.
BRAND_NAME=
# URL de checkout del producto en Gumroad, Lemon Squeezy o Hotmart. Sin ella no se permite el despliegue.
CHECKOUT_URL=
# manual | netlify | vercel. "manual" solo deja dist/site listo para subir.
DEPLOY_PROVIDER=manual
# Solo si DEPLOY_PROVIDER=netlify
NETLIFY_AUTH_TOKEN=
NETLIFY_SITE_ID=
# Solo si DEPLOY_PROVIDER=vercel
VERCEL_TOKEN=

# --- Avanzado (opcional) ---
# SWARM_STATE_FILE=state/swarm.json
# SWARM_OUTPUT_DIR=output
# SWARM_LOG_DIR=logs
