# Postgres (Supabase / Neon). Sin esta variable la app corre en modo demo
# con los datos de prisma/seed-data.ts, sin tocar la base.
DATABASE_URL="postgresql://usuario:password@host:5432/petvet?schema=public"

# Clave para entrar a /admin/revision. Si no se define, el panel queda
# abierto solo en desarrollo y bloqueado en produccion.
ADMIN_TOKEN="cambia-esto"
